# ---------------------------------------------------------------------------
# SmartDesk AI — server environment.
# Copy to .env. NEVER commit .env. No real credential belongs in this file.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) -----------------------------------------
# Leave BLANK to keep running the original single-tenant receptionist.
# Set it to enable the multi-tenant platform and the Control Center API.
# Use the connection-pooler URI from Supabase > Project Settings > Database.
DATABASE_URL=DATABASE_URL=postgresql://postgres.xbfajdzcfuicctquhnwr:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Use ONE of the following, matching your project's JWT signing method.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# --- Platform access -------------------------------------------------------
# Comma-separated. These emails become SmartDesk administrators on first login.
PLATFORM_ADMIN_EMAILS=
# Origins allowed to call the API (the dashboard).
DASHBOARD_ORIGINS=http://localhost:5173

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Leave ON in every deployed environment. Only tests set this to false.
TWILIO_VALIDATE_SIGNATURE=true
# Public base URL Twilio signs, e.g. https://smartdesk.onrender.com
TWILIO_WEBHOOK_BASE_URL=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=10

# --- Guardrails ------------------------------------------------------------
MAX_INBOUND_MESSAGE_CHARS=1500
MAX_CONVERSATION_HISTORY=20

# --- Voice -----------------------------------------------------------------
VOICE_LISTEN_TIMEOUT_SECONDS=30
VOICE_SPEECH_TIMEOUT_SECONDS=auto
TWILIO_VOICE_LANGUAGE=en-US
VOICE_MAX_SILENCE_REPROMPTS=2

# --- Seeding ---------------------------------------------------------------
# Numbers are only registered as channels if you supply them here.
# A wrong number would route one business's customers to another, so these
# are intentionally left blank.
SALON_TENANT_NAME=
SMARTDESK_WHATSAPP_NUMBER=
SMARTDESK_VOICE_NUMBER=
TENBY20_WHATSAPP_NUMBER=
TENBY20_VOICE_NUMBER=
SALON_WHATSAPP_NUMBER=
SALON_VOICE_NUMBER=
TEST_WHATSAPP_NUMBER=
TEST_VOICE_NUMBER=

# --- Google Calendar (per-tenant OAuth) -------------------------------------
# From Google Cloud Console: create an OAuth 2.0 Client ID (Web application),
# enable the Calendar API, add the redirect URI below as an authorized one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:10000/calendar/oauth/callback
# Signs the OAuth state parameter. Optional -- falls back to
# SUPABASE_JWT_SECRET if unset, so this only needs a value if you want to
# rotate it independently.
OAUTH_STATE_SECRET=

# --- Legacy single-tenant fallback (used only when DATABASE_URL is blank) ---
BUSINESS_NAME=SmartDesk AI
BUSINESS_LOCATION=
BOOKING_URL=
BUSINESS_TIMEZONE=Africa/Gaborone
OWNER_WHATSAPP=
TWILIO_WHATSAPP_NUMBER=
STATE_DIR=.
