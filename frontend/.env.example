# Supabase project settings for the dashboard.
# The anon key is a public, publishable key — it is safe in the browser and is
# NOT the service role key. Never put the service role key or any Twilio or
# OpenAI credential in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Leave blank in development (the Vite proxy handles it).
VITE_API_BASE_URL=
